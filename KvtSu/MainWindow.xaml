<Window
    x:Class="KvtSu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KvtSu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <GroupBox Header="Парсинг">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="btnParseBrand"
                        Click="btnParseBrand_Click"
                        Content="Парсинг бренда" />
                    <CheckBox
                        x:Name="chbxParseOnlyListSku"
                        VerticalAlignment="Center"
                        Content="Парсить только артикулы из файла sku__white__list.txt" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Ресурсы">
                <StackPanel>
                    <Button
                        x:Name="btnDownloadResources"
                        Click="btnDownloadResources_Click"
                        Content="Скачать ресурсы" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Экспорт">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="2,2,8,2"
                            VerticalAlignment="Center"
                            Text="pid" />
                        <TextBox
                            x:Name="txtProductId"
                            Width="50"
                            Margin="2,2,8,2"
                            VerticalContentAlignment="Center"
                            Text="429646" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btnGeneralExport"
                            Click="btnGeneralExport_Click"
                            Content="Товары" />
                        <Button
                            x:Name="btnAdditionalImages"
                            Click="btnAdditionalImages_Click"
                            Content="Изображения" />
                        <Button
                            x:Name="btnGetDimensionsSql"
                            Click="btnGetDimensionsSql_Click"
                            Content="SQL Dimensions" />
                        <Button
                            x:Name="btnAdditionalImagesSql"
                            Click="btnAdditionalImagesSql_Click"
                            Content="SQL Images" />
                        <Button
                            x:Name="btnSqlDescription"
                            Click="btnSqlDescription_Click"
                            Content="SQL Description" />
                        <Button
                            x:Name="btnSqlPdf"
                            Click="btnSqlPdf_Click"
                            Content="SQL PDF" />
                        <Button
                            x:Name="btnClipboardToCategories"
                            Click="btnClipboardToCategories_Click"
                            Content="Категории из клавиатуры" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" />

                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ProgressBar
            x:Name="pbIndicator"
            Grid.Row="1"
            Height="14"
            Margin="2"
            Maximum="1"
            Minimum="0"
            Value="0" />
    </Grid>
</Window>
